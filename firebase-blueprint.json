{
  "collections": [
    {
      "name": "users",
      "documentId": "uid",
      "rules": "allow read, write: if request.auth != null && request.auth.uid == uid;",
      "schema": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "displayName": { "type": "string" }
        }
      }
    },
    {
      "name": "tasks",
      "documentId": "taskId",
      "rules": "allow read, write: if request.auth != null && request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;",
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "deadline": { "type": "string", "format": "date-time" },
          "estimatedTime": { "type": "string" },
          "priority": { "type": "string" },
          "completed": { "type": "boolean" },
          "notes": { "type": "string" },
          "aiNote": { "type": "string" },
          "suggestedStart": { "type": "string" },
          "addedAt": { "type": "string", "format": "date-time" },
          "riskScore": { "type": "number" },
          "completionProbability": { "type": "number" }
        },
        "required": ["userId", "name", "category", "addedAt"]
      }
    },
    {
      "name": "schedules",
      "documentId": "scheduleId",
      "rules": "allow read, write: if request.auth != null && request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;",
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "summary": { "type": "string" },
          "generatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "generatedAt"]
      }
    },
    {
      "name": "habits",
      "documentId": "habitId",
      "rules": "allow read, write: if request.auth != null && request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;",
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "streak": { "type": "number" }
        },
        "required": ["userId", "name", "category", "streak"]
      }
    },
    {
      "name": "focusSessions",
      "documentId": "sessionId",
      "rules": "allow read, write: if request.auth != null && request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId;",
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "duration": { "type": "number" },
          "completedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "duration", "completedAt"]
      }
    }
  ]
}
